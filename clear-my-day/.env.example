# Server-side deployment configuration. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Public upstream credentials currently used by Sorbonne's shared calendars.
CALDAV_USERNAME=student.master
CALDAV_PASSWORD=guest

# Optional verbose diagnostics. Leave disabled in production.
CLEAR_MY_DAY_DEBUG=0
